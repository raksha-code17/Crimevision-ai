# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.15

# Set to false to skip loading heavy models (heuristic fallbacks only)
USE_ML_MODELS=true
ENABLE_CAPTIONING=false

RTDETR_MODEL=PekingU/rtdetr_r50vd
CLIP_MODEL=openai/clip-vit-base-patch32
WHISPER_MODEL=openai/whisper-base
CAPTION_MODEL=Salesforce/blip-image-captioning-base

HOST=127.0.0.1
PORT=5000
MAX_UPLOAD_MB=500
VIDEO_MAX_SECONDS=300
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Image/video understanding with a Groq vision model (images are sent to Groq's cloud).
# Set CLOUD_VISION=false to keep all images on your machine.
CLOUD_VISION=true
GROQ_VISION_MODELS=qwen/qwen3.8-27b,qwen/qwen3.6-27b,meta-llama/llama-4-scout-17b-16e-instruct
DETECTION_THRESHOLD=0.4
FORENSIC_TAG_THRESHOLD=0.3
VIDEO_KEYFRAMES=5
